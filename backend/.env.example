# Copy to backend/.env and fill in. NEVER commit the real .env.
DATABASE_URL=postgres://user:password@host:5432/zzportal
JWT_SECRET=replace-with-a-long-random-string
# 1 in production (HTTPS), 0 for local http dev
COOKIE_SECURE=0
# If the portal is served from a different origin than this API (e.g. the S3 site),
# list it here so cross-origin cookies work. Leave blank if same-origin.
ALLOWED_ORIGINS=
