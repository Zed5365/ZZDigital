# Copy this to ".env" (same folder as docker-compose.yml) and fill in.
# NEVER commit the real .env. Both are just long random strings you make up.
DB_PASSWORD=make-up-a-strong-db-password
JWT_SECRET=make-up-a-long-random-string-30-plus-chars
# Access key for the 'zzdigital-portal-uploader' IAM user (for client image uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
